# Copy to .env for local development. Never commit the real .env.
# In production these are set as environment variables on the host (Railway →
# Variables), which is why no key is ever read outside src/config.js.

# --- Service ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Storage ---------------------------------------------------------------
# Leave DATABASE_URL empty for local development: the app uses a local SQLite
# file via Node's built-in node:sqlite, with no account and no setup.
#
# In production set both of these to a Turso database (hosted libSQL, which is
# SQLite over the network). Required on any host with an ephemeral filesystem —
# a local file there is erased on every restart.
#   turso db create patient-registry
#   turso db show patient-registry --url        -> DATABASE_URL
#   turso db tokens create patient-registry     -> DATABASE_AUTH_TOKEN
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Only used when DATABASE_URL is empty.
DATABASE_PATH=./data/patients.sqlite

# Public https URL of this service. Required to provision the Vapi assistant,
# because Vapi needs somewhere to send tool calls.
#   Local dev:  ngrok http 3000  →  https://xxxx.ngrok-free.app
#   Production: https://your-app.up.railway.app
PUBLIC_BASE_URL=

# --- Vapi ------------------------------------------------------------------
# Private API key: Vapi dashboard → Settings → API Keys.
VAPI_API_KEY=

# Shared secret sent back by Vapi as the `x-vapi-secret` header on every
# webhook. Set it to any long random string; the webhook rejects calls without
# it. Generate one with:  openssl rand -hex 32
VAPI_SERVER_SECRET=

# Set after the first `npm run provision:vapi` so re-runs update in place.
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# --- Voice agent tuning (all optional; defaults shown) ----------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# LLM_TEMPERATURE=0.4
# VOICE_PROVIDER=vapi
# VOICE_ID=Savannah
# TRANSCRIBER_MODEL=nova-3
# TRANSCRIBER_LANGUAGE=multi

# --- API hardening (optional) ----------------------------------------------
# If set, POST/PUT/DELETE require `Authorization: Bearer <key>`.
# Left unset so the API can be reviewed without credentials.
# API_KEY=
# RATE_LIMIT_MAX=240
# RATE_LIMIT_WINDOW_MS=60000
